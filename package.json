{
  "name": "liftara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LIFTARA - Train Smart. Grow Strong. Mehrsprachige Fitness-PWA (DE/EN/AR).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "build:preview": "node scripts/build-preview-media.mjs && vite build --config vite.preview.config.ts",
    "media:import": "node scripts/import-exercise-media.mjs",
    "media:generate": "node scripts/generate-media.mjs",
    "media:reindex": "node scripts/reindex-media.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "dexie": "^4.0.10",
    "i18next": "^23.16.8",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@sparticuz/chromium-min": "^153.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
